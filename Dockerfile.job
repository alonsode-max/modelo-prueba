# Dockerfile.job — imagen de los jobs de pipeline (datos, entrena)
# Single-stage on purpose: there is nothing to compile here, so a builder
# stage would be decoration. (The docker workshop used multi-stage because
# Node/TS actually built something.)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Deps first: this layer only rebuilds when requirements.txt changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY configs ./configs

# data/raw is bind-mounted read-only; data/work + models are named volumes.
CMD ["python", "-m", "src.run_pipeline"]
