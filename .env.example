# .env.example — copia a `.env` y ajusta (`cp .env.example .env`)
# Compose interpola ${VAR:-default}: sin .env todo funciona con los defaults.
# NADA de secretos reales aquí: los valores son PLANO de trabajo del taller.

# URI del tracking server DESDE DENTRO de la red docker (jobs y api):
MLFLOW_TRACKING_URI=http://mlflow:5000
# (Para ejecutar clientes desde el portátil, la misma puerta ya mapeada:
#  mlflow server URI = http://localhost:5555)

# Nombre y alias en el Model Registry:
MODEL_NAME=vuelo-retraso
MODEL_ALIAS=Production

# Backend de la API: inference_registry (modo registry, estado final)
#                     inference          (modo pkl local, el del libro — s6)
INFERENCE_MODULE=inference_registry

API_PORT=8000
# (si otro proceso ocupa tu 8000: API_PORT=18000 — el streamlit interno usa http://api:8000)

# Para el job de datos:
RAW_FILE=data/raw/flights.csv

# --- SOLO para la sección de CI (GitHub Actions -> GHCR) ---------------------
# Patrón de credenciales FALSA: en tu repo real van como SECRET del repo,
# nunca como texto en un fichero commiteado.
GHCR_IMAGE=ghcr.io/TU-USUARIO/flight-delay-api
GHCR_TOKEN=ghp_FAKE_TOKEN_no_es_un_secreto_real_borrame_cuando_lo_crees
# En el workflow real el token es GITHUB_TOKEN (permisos packages:write) y no
# se pone en ningún .env.
